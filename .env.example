# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this to .env and fill in real values.
#                  NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (docker-compose.full.yml / production) ─────────────────────────
DB_URL=jdbc:postgresql://postgres:5432/opsdb
DB_USER=ops
DB_PASSWORD=changeme_in_production

# ── JWT signing secret ─────────────────────────────────────────────────────────
# Must be >= 32 characters.  Generate one with:
#   openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-string

# ── AI provider ───────────────────────────────────────────────────────────────
# Set AI_PROVIDER=mock to use keyword + templates (no API key needed, default).
# Set AI_PROVIDER=llm  to use the OpenAI-compatible API configured below.
AI_PROVIDER=mock

# Base URL for the LLM API.  Groq example:
AI_BASE_URL=https://api.groq.com/openai/v1

# Your API key.  Keep this secret – never hard-code it in source files.
# Groq:   https://console.groq.com/keys
# OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=

# Model name recognised by the provider above.
AI_MODEL=openai/gpt-oss-120b

# ── CORS (frontend origin seen by the browser) ────────────────────────────────
# For the full-stack Docker Compose stack the frontend is served on port 8081.
CORS_ORIGINS=http://localhost:8081

# ── Data seeder ───────────────────────────────────────────────────────────────
# Set to true ONLY in development to auto-create demo users & tickets.
# Leave false (default) in production.
# APP_SEED_ENABLED=false
