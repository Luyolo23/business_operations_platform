# ─────────────────────────────────────────────────────────────────────────────
# .env.example  –  Copy this to .env and fill in real values.
#                  NEVER commit .env to git.
#
# Used by:
#   • local `mvn spring-boot:run` / `make backend` (export it first:
#     `set -a && . ./.env && set +a`)
#   • `docker compose -f docker-compose.full.yml` (passed with --env-file .env)
#
# The values below are the LOCAL DEV defaults (Postgres on localhost:5433).
# The full-stack Compose file overrides DB_URL and CORS_ORIGINS itself, so you
# do NOT need to change them for Containers. See the notes on each section.
# ─────────────────────────────────────────────────────────────────────────────

# ── PostgreSQL (local dev: `docker compose up -d`, host port 5433) ────────────
# docker-compose.full.yml overrides this to jdbc:postgresql://postgres:5432/opsdb
# inside the backend container, so keep the localhost value here.
DB_URL=jdbc:postgresql://localhost:5433/opsdb
DB_USER=ops
DB_PASSWORD=ops

# ── JWT signing secret ─────────────────────────────────────────────────────────
# Required in every profile except dev, which has a committed local-only fallback.
# Must be at least 32 bytes. Generate one with:
#   openssl rand -base64 48
# Left blank on purpose: the default profile and docker-compose.full.yml refuse
# to start until you set a real value. The dev profile has a local-only fallback.
JWT_SECRET=

# ── Spring profile / demo data ─────────────────────────────────────────────────
# Uncomment to enable demo seeding locally (equivalent to `make backend`).
# Leave empty in production.
# SPRING_PROFILES_ACTIVE=dev

# Shows the demo-account pills on the login page. The dev profile sets this to
# true. Keep it false/unset in production: the pills advertise seeded credentials.
APP_DEMO_SHOW_ACCOUNTS=false

# Interactive API docs (Swagger UI / OpenAPI). Off by default; the dev profile
# turns them on. Keep false in production: the schema maps every endpoint.
# APP_API_DOCS_ENABLED=false

# ── AI provider ───────────────────────────────────────────────────────────────
# Set AI_PROVIDER=mock to use keyword + templates (no API key needed, default).
# Set AI_PROVIDER=llm  to use the OpenAI-compatible API configured below.
AI_PROVIDER=mock

# Base URL for the LLM API.  Groq example:
AI_BASE_URL=https://api.groq.com/openai/v1

# Your API key.  Keep this secret – never hard-code it in source files.
# Groq:   https://console.groq.com/keys
# OpenAI: https://platform.openai.com/api-keys
AI_API_KEY=

# Model name recognised by the provider above.
AI_MODEL=openai/gpt-oss-120b

# ── CORS (frontend origin seen by the browser) ────────────────────────────────
# Local Vite dev server. docker-compose.full.yml overrides this to
# http://localhost:8081 for the Nginx-served frontend.
CORS_ORIGINS=http://localhost:5173

# ── Data seeder ───────────────────────────────────────────────────────────────
# Set to true ONLY in development to auto-create demo users & tickets.
# Leave false (default) in production. Prefer the dev profile above.
# APP_SEED_ENABLED=false
